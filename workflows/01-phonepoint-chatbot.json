      "webhookId": "phonepoint-chat-trigger"
    },
    {
      "parameters": {
        "url": "https://raw.githubusercontent.com/lidor-byte/phonepoint-n8n-final-project/main/knowledge/phonepoint-knowledge.txt",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "0efc969b-1a95-4d86-9400-002",
      "name": "Get PhonePoint Knowledge from GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-520, 0]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('When chat message received').item.json.chatInput }}",
        "options": {
          "systemMessage": "=את/ה נציג/ת שירות לקוחות של PhonePoint, חנות טלפונים. השב/י בעברית, בחמימות ובקצרה. מותר לענות רק על PhonePoint, טלפונים, אביזרים, תיקונים, שעות פעילות, מדיניות החנות והתאמת טלפון. אם השאלה אינה קשורה לעסק, השב/י בדיוק: אני כאן כדי לעזור רק בנושאים שקשורים ל-PhonePoint ולמוצרי החנות. איך אוכל לסייע לגבי טלפון או אביזר? אין להמציא מלאי, מבצעים, מפרטי מוצרים או מדיניות; לגבי מלאי עדכני יש להפנות לבדיקה מול החנות. הסתמך/י רק על המידע הבא שהתקבל מקובץ הידע ב-GitHub:

{{ $json.data }}"
        }
      },
      "id": "0efc969b-1a95-4d86-9400-003",
