{
  "name": "PhonePoint AI Chatbot - Gemini + GitHub Knowledge",
  "nodes": [
    {
      "parameters": {
        "mode": "hostedChat",
        "options": {
          "title": "PhonePoint AI"
        }
      },
      "id": "1",
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.2,
      "position": [
        -600,
        0
      ],
      "webhookId": "phonepoint-chat-trigger"
    },
    {
      "parameters": {
        "url": "https://raw.githubusercontent.com/lidor-byte/phonepoint-n8n-final-project/main/knowledge/phonepoint-knowledge.txt",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "2",
      "name": "Get PhonePoint Knowledge from GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -350,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('When chat message received').item.json.chatInput }}",
        "options": {
          "systemMessage": "=את/ה נציג/ת שירות לקוחות של PhonePoint. ענה/י רק על טלפונים, אביזרים, תיקונים, שעות פעילות ומדיניות החנות. אם השאלה לא קשורה, השב/י: אני כאן כדי לעזור רק בנושאים שקשורים ל-PhonePoint ולמוצרי החנות. מידע מהחנות: {{ $json.data }}"
        }
      },
      "id": "3",
      "name": "PhonePoint AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        -100,
        0
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.0-flash",
        "options": {}
      },
      "id": "4",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        -100,
        200
      ]
    },
    {
      "parameters": {
        "sessionKey": "={{ $('When chat message received').item.json.sessionId }}",
        "contextWindowLength": 15
      },
      "id": "5",
      "name": "15 Message Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        100,
        200
      ]
    }
  ],
  "pinData": {},
